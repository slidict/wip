<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Wip</RootNamespace>
    <!-- LibraryImport source generation emits unsafe marshalling code (ResourceMonitor). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wip.Tests" />
    <!-- The CLI assembly, which is wip itself. #692 keeps the scanning contract internal to
         wip rather than an API anyone outside it can implement, and the command that drives a
         scan lives here, so this is what "wip内部専用" means in project terms. -->
    <InternalsVisibleTo Include="wip" />
  </ItemGroup>

</Project>
