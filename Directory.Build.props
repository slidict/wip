<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Version>2.0.3</Version>
    <Authors>wip contributors</Authors>
    <Product>wip</Product>
    <Description>A developer-friendly CLI wrapper for Microsoft WSLC.</Description>
    <RepositoryUrl>https://github.com/slidict/wip</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <!--
    Trimming and globalization settings live here rather than in Wip.Cli alone so the
    analyzers run over Wip.Core too: a reflection dependency introduced in the library
    has to fail the build where it is written, not at publish time in a different project.
  -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
