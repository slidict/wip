    {
      "path": "docs/guide.md",
      "ignored": true,
      "prunable": false
    },
    {
      "path": "docs/README.md",
      "ignored": false,
      "prunable": false
    },
    {
      "path": "docs/nested/guide.md",
      "ignored": false,
      "prunable": false
    },
    {
      "path": "build",
      "ignored": false,
      "prunable": false
    },
    {
      "path": "build/output",
      "ignored": true,
      "prunable": false
    },
    {
      "path": "build/output/bin",
      "ignored": true,
      "prunable": false
    },
    {
      "path": "build/other",
      "ignored": false,
      "prunable": false
    }
